          CFI FunCall Get_battery_volt
        CALLA   #Get_battery_volt
        MOV.W   R12, R10
        MOVX.W  &Voltage_Temp, R12
        MOV.W   R12, R15
        RLAM.W  #0x3, R12
        ADD.W   R15, R12
        MOV.W   #0xa, R14
          CFI FunCall ?DivMod16s
        CALLA   #?DivMod16s
        MOV.W   R12, R11
        MOV.W   R10, R12
        MOV.W   #0xa, R14
          CFI FunCall ?DivMod16s
        CALLA   #?DivMod16s
        ADD.W   R12, R11
        MOVX.W  R11, &Voltage_Temp
//  397         }//=====读取电池电压		
//  398    	fenpin++;	                                   
??TIMER_TA0_A0_IRQ_Handler_1:
        ADDX.W  #0x1, &??fenpin
