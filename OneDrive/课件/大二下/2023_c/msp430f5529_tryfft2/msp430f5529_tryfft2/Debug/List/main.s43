          CFI FunCall GPIO_MultiBits_Init
        CALLA   #GPIO_MultiBits_Init
//  244   GPIO_Init(P2,1,GPI|PULL_UP);
        MOV.W   #0x21, R14
        MOV.W   #0x2, R13
        MOV.B   #0x1, R12
          CFI TailCall GPIO_MultiBits_Init
        BRA     #GPIO_MultiBits_Init
//  245 }
          CFI EndBlock cfiBlock4
//  246 
//  247 
//  248 
//  249 

        RSEG `CODE`:CODE:REORDER:NOROOT(1)
//  250 void motor_PWM_init()//编码器定时器定义
motor_PWM_init:
          CFI Block cfiBlock5 Using cfiCommon1
          CFI Function motor_PWM_init
//  251 {
//  252    //定时器B0，频率10K
//  253   //TIMER_PWM_MultiChannel_Init      (TIMER_B0,10000, 1 ,TIMER_CH5);   //定时器TB0，通道5，P3.5
//  254   TIMER_PWM_Init(TIMER_B0,400,TIMER_CH5);   //定时器TB0，通道5，P3.5
        PUSH.W  #0x5
          CFI CFA SP+6
        MOV.B   #0x1, R13
        MOV.W   #0x190, R14
        MOV.W   #0x0, R15
        MOV.B   #0x3, R12
          CFI FunCall TIMER_PWM_MultiChannel_Init
        CALLA   #TIMER_PWM_MultiChannel_Init
//  255   TIMER_PWM_Init(TIMER_B0,400,TIMER_CH2);   //定时器TB0，通道5，P3.5
        PUSH.W  #0x2
          CFI CFA SP+8
        MOV.B   #0x1, R13
        MOV.W   #0x190, R14
        MOV.W   #0x0, R15
        MOV.B   #0x3, R12
          CFI FunCall TIMER_PWM_MultiChannel_Init
        CALLA   #TIMER_PWM_MultiChannel_Init
//  256   TIMER_PWM_Init(TIMER_B0,400,TIMER_CH6);//P3.6
        PUSH.W  #0x6
          CFI CFA SP+10
        MOV.B   #0x1, R13
        MOV.W   #0x190, R14
        MOV.W   #0x0, R15
        MOV.B   #0x3, R12
          CFI FunCall TIMER_PWM_MultiChannel_Init
        CALLA   #TIMER_PWM_MultiChannel_Init
//  257   TIMER_PWM_SetChannelDuty  (TIMER_B0, TIMER_CH6, 0);             //设置某一个定时器某一个通道的占空比
        MOV.W   #0x0, R14
        MOV.W   #0x0, R15
        MOV.B   #0x6, R13
        MOV.B   #0x3, R12
          CFI FunCall TIMER_PWM_SetChannelDuty
        CALLA   #TIMER_PWM_SetChannelDuty
//  258   TIMER_PWM_SetChannelDuty  (TIMER_B0, TIMER_CH5, 0);
        MOV.W   #0x0, R14
        MOV.W   #0x0, R15
        MOV.B   #0x5, R13
        MOV.B   #0x3, R12
          CFI FunCall TIMER_PWM_SetChannelDuty
        CALLA   #TIMER_PWM_SetChannelDuty
//  259   TIMER_PWM_SetChannelDuty  (TIMER_B0, TIMER_CH2, 510);
        MOV.W   #0x1fe, R14
        MOV.W   #0x0, R15
        MOV.B   #0x2, R13
        MOV.B   #0x3, R12
          CFI FunCall TIMER_PWM_SetChannelDuty
        CALLA   #TIMER_PWM_SetChannelDuty
//  260 }
        ADDA    #0x6, SP
          CFI CFA SP+4
        RETA
          CFI EndBlock cfiBlock5
//  261 
//  262 /**************************************************************************
//  263 函数功能：小车运动数学模型
//  264 入口参数：速度和转角
//  265 返回  值：无
//  266 **************************************************************************/

        RSEG `CODE`:CODE:REORDER:NOROOT(1)
//  267 void Kinematic_Analysis(float velocity,float angle)
Kinematic_Analysis:
          CFI Block cfiBlock6 Using cfiCommon1
          CFI Function Kinematic_Analysis
//  268 {
        PUSHM.A #0x6, R11
          CFI R6L Frame(CFA, -28)
          CFI R6H Frame(CFA, -26)
          CFI R7L Frame(CFA, -24)
          CFI R7H Frame(CFA, -22)
          CFI R8L Frame(CFA, -20)
          CFI R8H Frame(CFA, -18)
          CFI R9L Frame(CFA, -16)
          CFI R9H Frame(CFA, -14)
          CFI R10L Frame(CFA, -12)
          CFI R10H Frame(CFA, -10)
          CFI R11L Frame(CFA, -8)
          CFI R11H Frame(CFA, -6)
          CFI CFA SP+28
        MOV.W   R12, R8
        MOV.W   R13, R9
        MOV.W   R14, R10
        MOV.W   R15, R11
//  269 		Target_B=(int)(velocity*(1+T*tan(angle*3.14/180)/2/L)); 
        MOV.W   R10, R12
        MOV.W   R11, R13
        MOV.W   #0xf5c3, R14
        MOV.W   #0x4048, R15
          CFI FunCall _Mul32f
        CALLA   #_Mul32f
        MOV.W   #0x0, R14
        MOV.W   #0x4334, R15
          CFI FunCall _Div32f
        CALLA   #_Div32f
          CFI FunCall tan
        CALLA   #tan
        MOV.W   #0x0, R14
        MOV.W   #0x4020, R15
          CFI FunCall _Mul32f
        CALLA   #_Mul32f
        MOV.W   #0x0, R14
        MOV.W   #0x4000, R15
          CFI FunCall _Div32f
        CALLA   #_Div32f
        MOV.W   #0x0, R14
        MOV.W   #0x3f80, R15
          CFI FunCall _Div32f
        CALLA   #_Div32f
        MOV.W   #0x0, R14
        MOV.W   #0x3f80, R15
          CFI FunCall _Add32f
        CALLA   #_Add32f
        MOV.W   R8, R14
        MOV.W   R9, R15
          CFI FunCall _Mul32f
        CALLA   #_Mul32f
          CFI FunCall _Cast32fto32s
        CALLA   #_Cast32fto32s
        MOVX.W  R12, &Target_B
//  270 		Target_A=(int)(velocity*(1-T*tan(angle*3.14/180)/2/L));      //后轮差速
        MOV.W   #0x0, R12
        MOV.W   #0x3f80, R13
        MOV.W   R12, R6
        MOV.W   R13, R7
        MOV.W   R10, R12
        MOV.W   R11, R13
        MOV.W   #0xf5c3, R14
        MOV.W   #0x4048, R15
          CFI FunCall _Mul32f
        CALLA   #_Mul32f
        MOV.W   #0x0, R14
        MOV.W   #0x4334, R15
          CFI FunCall _Div32f
        CALLA   #_Div32f
          CFI FunCall tan
        CALLA   #tan
        MOV.W   #0x0, R14
        MOV.W   #0x4020, R15
          CFI FunCall _Mul32f
        CALLA   #_Mul32f
        MOV.W   #0x0, R14
        MOV.W   #0x4000, R15
          CFI FunCall _Div32f
        CALLA   #_Div32f
        MOV.W   #0x0, R14
        MOV.W   #0x3f80, R15
          CFI FunCall _Div32f
        CALLA   #_Div32f
        MOV.W   R12, R14
        MOV.W   R13, R15
        MOV.W   R6, R12
        MOV.W   R7, R13
          CFI FunCall _Sub32f
        CALLA   #_Sub32f
        MOV.W   R8, R14
        MOV.W   R9, R15
          CFI FunCall _Mul32f
        CALLA   #_Mul32f
          CFI FunCall _Cast32fto32s
        CALLA   #_Cast32fto32s
        MOVX.W  R12, &Target_A
//  271 		Servo=(int)(SERVO_INIT+angle*K);                    //舵机转向 
        MOV.W   R10, R12
        MOV.W   R11, R13
        MOV.W   #0x147b, R14
        MOV.W   #0x410e, R15
          CFI FunCall _Mul32f
        CALLA   #_Mul32f
        MOV.W   #0x0, R14
        MOV.W   #0x4416, R15
          CFI FunCall _Add32f
        CALLA   #_Add32f
          CFI FunCall _Cast32fto32s
        CALLA   #_Cast32fto32s
        MOVX.W  R12, &Servo
//  272                 if(Servo>850)Servo=850;
        CMPX.W  #0x353, &Servo
        JL      ??Kinematic_Analysis_0
        MOVX.W  #0x352, &Servo
//  273                 if(Servo<250)Servo=250;
??Kinematic_Analysis_0:
        CMPX.W  #0xfa, &Servo
        JGE     ??Kinematic_Analysis_1
        MOVX.W  #0xfa, &Servo
//  274 }
??Kinematic_Analysis_1:
        POPM.A  #0x6, R11
          CFI R10H SameValue
          CFI R11H SameValue
          CFI R6H SameValue
          CFI R7H SameValue
          CFI R8H SameValue
          CFI R9H SameValue
          CFI R10L SameValue
          CFI R11L SameValue
          CFI R6L SameValue
          CFI R7L SameValue
          CFI R8L SameValue
          CFI R9L SameValue
          CFI CFA SP+4
        RETA
          CFI EndBlock cfiBlock6
//  275 
//  276 /**************************************************************************
//  277 函数功能：赋值给PWM寄存器
//  278 入口参数：左轮PWM、右轮PWM
//  279 返回  值：无
//  280 **************************************************************************/

        RSEG `CODE`:CODE:REORDER:NOROOT(1)
//  281 void Set_Pwm(int motor_a,int motor_b,int servo)
Set_Pwm:
          CFI Block cfiBlock7 Using cfiCommon1
          CFI Function Set_Pwm
//  282 {
        PUSHM.A #0x4, R11
          CFI R8L Frame(CFA, -20)
          CFI R8H Frame(CFA, -18)
          CFI R9L Frame(CFA, -16)
          CFI R9H Frame(CFA, -14)
          CFI R10L Frame(CFA, -12)
          CFI R10H Frame(CFA, -10)
          CFI R11L Frame(CFA, -8)
          CFI R11H Frame(CFA, -6)
          CFI CFA SP+20
        MOV.W   R12, R11
        MOV.W   R13, R10
        MOV.W   R14, R8
//  283   if(RUND_FLAG==0)
        CMPX.B  #0x0, &RUND_FLAG
        JNE     ??Set_Pwm_1
//  284   {
//  285   GPIO_WriteBit(P1,2,0);
        MOV.B   #0x0, R14
        MOV.B   #0x2, R13
        MOV.B   #0x0, R12
          CFI FunCall GPIO_WriteBit
        CALLA   #GPIO_WriteBit
//  286   GPIO_WriteBit(P1,3,0);
        MOV.B   #0x0, R14
        MOV.B   #0x3, R13
        MOV.B   #0x0, R12
          CFI FunCall GPIO_WriteBit
        CALLA   #GPIO_WriteBit
//  287   TIMER_PWM_SetChannelDuty  (TIMER_B0, TIMER_CH6, motor_a);
        MOV.W   R11, R14
        MOV.W   R14, R15
        RLA.W   R15
        SUBC.W  R15, R15
        XOR.W   #0xffff, R15
        MOV.B   #0x6, R13
        MOV.B   #0x3, R12
          CFI FunCall TIMER_PWM_SetChannelDuty
        CALLA   #TIMER_PWM_SetChannelDuty
//  288   TIMER_PWM_SetChannelDuty  (TIMER_B0, TIMER_CH5, motor_b);
        MOV.W   R10, R14
        MOV.W   R14, R15
        RLA.W   R15
        SUBC.W  R15, R15
        XOR.W   #0xffff, R15
        MOV.B   #0x5, R13
        MOV.B   #0x3, R12
          CFI FunCall TIMER_PWM_SetChannelDuty
        CALLA   #TIMER_PWM_SetChannelDuty
        JMP     ??Set_Pwm_0
//  289   }
//  290   else if(RUND_FLAG==1)
??Set_Pwm_1:
        CMPX.B  #0x1, &RUND_FLAG
        JNE     ??Set_Pwm_0
//  291   {
//  292   GPIO_WriteBit(P1,2,1);
        MOV.B   #0x1, R14
        MOV.B   #0x2, R13
        MOV.B   #0x0, R12
          CFI FunCall GPIO_WriteBit
        CALLA   #GPIO_WriteBit
//  293   GPIO_WriteBit(P1,3,1);
        MOV.B   #0x1, R14
        MOV.B   #0x3, R13
        MOV.B   #0x0, R12
          CFI FunCall GPIO_WriteBit
        CALLA   #GPIO_WriteBit
//  294   TIMER_PWM_SetChannelDuty  (TIMER_B0, TIMER_CH6, 1000-motor_a);
        MOV.W   #0x3e8, R14
        SUB.W   R11, R14
        MOV.W   R14, R15
        RLA.W   R15
        SUBC.W  R15, R15
        XOR.W   #0xffff, R15
        MOV.B   #0x6, R13
        MOV.B   #0x3, R12
          CFI FunCall TIMER_PWM_SetChannelDuty
        CALLA   #TIMER_PWM_SetChannelDuty
//  295   TIMER_PWM_SetChannelDuty  (TIMER_B0, TIMER_CH5, 1000-motor_b);
        MOV.W   #0x3e8, R14
        SUB.W   R10, R14
        MOV.W   R14, R15
        RLA.W   R15
        SUBC.W  R15, R15
        XOR.W   #0xffff, R15
        MOV.B   #0x5, R13
        MOV.B   #0x3, R12
          CFI FunCall TIMER_PWM_SetChannelDuty
        CALLA   #TIMER_PWM_SetChannelDuty
//  296   }
//  297   TIMER_PWM_SetChannelDuty  (TIMER_B0, TIMER_CH2, servo);
??Set_Pwm_0:
        MOV.W   R8, R14
        MOV.W   R14, R15
        RLA.W   R15
        SUBC.W  R15, R15
        XOR.W   #0xffff, R15
        MOV.B   #0x2, R13
        MOV.B   #0x3, R12
          CFI FunCall TIMER_PWM_SetChannelDuty
        CALLA   #TIMER_PWM_SetChannelDuty
//  298 }
        POPM.A  #0x4, R11
          CFI R10H SameValue
          CFI R11H SameValue
          CFI R8H SameValue
          CFI R9H SameValue
          CFI R10L SameValue
          CFI R11L SameValue
          CFI R8L SameValue
          CFI R9L SameValue
          CFI CFA SP+4
        RETA
          CFI EndBlock cfiBlock7
//  299 
//  300 
//  301 

        RSEG `CODE`:CODE:REORDER:NOROOT(1)
//  302 int Get_battery_volt()
Get_battery_volt:
          CFI Block cfiBlock8 Using cfiCommon1
          CFI Function Get_battery_volt
//  303 {
        PUSHM.A #0x1, R10
          CFI R10L Frame(CFA, -8)
          CFI R10H Frame(CFA, -6)
          CFI CFA SP+8
//  304   int ad;
//  305   ad = ADC_ReadChanelOnce  (ADC_CH0);
        MOV.W   #0x1, R12
          CFI FunCall ADC_ReadChanelOnce
        CALLA   #ADC_ReadChanelOnce
        MOV.W   R12, R10
//  306   return ad;
        MOV.W   R10, R12
        POPM.A  #0x1, R10
          CFI R10H SameValue
          CFI R10L SameValue
          CFI CFA SP+4
        RETA
//  307 }
          CFI EndBlock cfiBlock8

        RSEG `CODE`:CODE:REORDER:NOROOT(1)
//  308 void Read_Encoder()
Read_Encoder:
          CFI Block cfiBlock9 Using cfiCommon1
          CFI Function Read_Encoder
//  309 {float angles;
        PUSHM.A #0x4, R11
          CFI R8L Frame(CFA, -20)
          CFI R8H Frame(CFA, -18)
          CFI R9L Frame(CFA, -16)
          CFI R9H Frame(CFA, -14)
          CFI R10L Frame(CFA, -12)
          CFI R10H Frame(CFA, -10)
          CFI R11L Frame(CFA, -8)
          CFI R11H Frame(CFA, -6)
          CFI CFA SP+20
//  310   speed_L=(long long)(300000/PulseWidth_r);
        MOV.W   #0x93e0, R12
        MOV.W   #0x4, R13
        MOVX.W  &PulseWidth_r, R14
        MOVX.W  &PulseWidth_r + 2, R15
          CFI FunCall ?DivMod32u
        CALLA   #?DivMod32u
        MOVX.W  R12, &speed_L
        MOVX.W  R13, &speed_L + 2
//  311     speed_R=(long long)(300000/PulseWidth_l);
        MOV.W   #0x93e0, R12
        MOV.W   #0x4, R13
        MOVX.W  &PulseWidth_l, R14
        MOVX.W  &PulseWidth_l + 2, R15
          CFI FunCall ?DivMod32u
        CALLA   #?DivMod32u
        MOVX.W  R12, &speed_R
        MOVX.W  R13, &speed_R + 2
//  312     if(overflowTime_r>50)
        CMPX.W  #0x33, &overflowTime_r
        JNC     ??Read_Encoder_0
//  313       speed_L=0;
        MOVX.W  #0x0, &speed_L
        MOVX.W  #0x0, &speed_L + 2
//  314     if(overflowTime_l>50)
??Read_Encoder_0:
        CMPX.W  #0x33, &overflowTime_l
        JNC     ??Read_Encoder_1
//  315       speed_R=0;
        MOVX.W  #0x0, &speed_R
        MOVX.W  #0x0, &speed_R + 2
//  316     if(overflowTime_o>50)
??Read_Encoder_1:
        CMPX.W  #0x33, &overflowTime_o
        JNC     ??Read_Encoder_2
//  317       PulseWidth_o=1500;
        MOVX.W  #0x5dc, &PulseWidth_o
        MOVX.W  #0x0, &PulseWidth_o + 2
//  318    angles=(float)((float)SBUS.Ch1-1000)*45/800;
??Read_Encoder_2:
        MOVX.W  &SBUS + 2, R12
        MOV.W   #0x0, R13
          CFI FunCall _Cast32uto32f
        CALLA   #_Cast32uto32f
        MOV.W   #0x0, R14
        MOV.W   #0xc47a, R15
          CFI FunCall _Add32f
        CALLA   #_Add32f
        MOV.W   #0x0, R14
        MOV.W   #0x4234, R15
          CFI FunCall _Mul32f
        CALLA   #_Mul32f
        MOV.W   #0x0, R14
        MOV.W   #0x4448, R15
          CFI FunCall _Div32f
        CALLA   #_Div32f
        MOV.W   R12, R10
        MOV.W   R13, R11
//  319    Angle=Angle*3/4+angles/4;
        MOVX.W  &Angle, R12
        MOVX.W  &Angle + 2, R13
        MOV.W   #0x0, R14
        MOV.W   #0x4040, R15
          CFI FunCall _Mul32f
        CALLA   #_Mul32f
        MOV.W   #0x0, R14
        MOV.W   #0x4080, R15
          CFI FunCall _Div32f
        CALLA   #_Div32f
        MOV.W   R12, R8
        MOV.W   R13, R9
        MOV.W   R10, R12
        MOV.W   R11, R13
        MOV.W   #0x0, R14
        MOV.W   #0x4080, R15
          CFI FunCall _Div32f
        CALLA   #_Div32f
        MOV.W   R8, R14
        MOV.W   R9, R15
          CFI FunCall _Add32f
        CALLA   #_Add32f
        MOVX.W  R12, &Angle
        MOVX.W  R13, &Angle + 2
//  320 }
        POPM.A  #0x4, R11
          CFI R10H SameValue
          CFI R11H SameValue
          CFI R8H SameValue
          CFI R9H SameValue
          CFI R10L SameValue
          CFI R11L SameValue
          CFI R8L SameValue
          CFI R9L SameValue
          CFI CFA SP+4
        RETA
          CFI EndBlock cfiBlock9
//  321 /**************************************************************************
//  322 函数功能：增量PI控制器
//  323 入口参数：编码器测量值，目标速度
//  324 返回  值：电机PWM
//  325 根据增量式离散PID公式 
//  326 pwm+=Kp[e（k）-e(k-1)]+Ki*e(k)+Kd[e(k)-2e(k-1)+e(k-2)]
//  327 e(k)代表本次偏差 
//  328 e(k-1)代表上一次的偏差  以此类推 
//  329 pwm代表增量输出
//  330 在我们的速度控制闭环系统里面，只使用PI控制
//  331 pwm+=Kp[e（k）-e(k-1)]+Ki*e(k)
//  332 **************************************************************************/

        RSEG `CODE`:CODE:REORDER:NOROOT(1)
//  333 int Incremental_PI_A (int Encoder,int Target)
Incremental_PI_A:
          CFI Block cfiBlock10 Using cfiCommon1
          CFI Function Incremental_PI_A
//  334 { 	
        PUSHM.A #0x8, R11
          CFI R4L Frame(CFA, -36)
          CFI R4H Frame(CFA, -34)
          CFI R5L Frame(CFA, -32)
          CFI R5H Frame(CFA, -30)
          CFI R6L Frame(CFA, -28)
          CFI R6H Frame(CFA, -26)
          CFI R7L Frame(CFA, -24)
          CFI R7H Frame(CFA, -22)
          CFI R8L Frame(CFA, -20)
          CFI R8H Frame(CFA, -18)
          CFI R9L Frame(CFA, -16)
          CFI R9H Frame(CFA, -14)
          CFI R10L Frame(CFA, -12)
          CFI R10H Frame(CFA, -10)
          CFI R11L Frame(CFA, -8)
          CFI R11H Frame(CFA, -6)
          CFI CFA SP+36
        MOV.W   R12, R7
        MOV.W   R13, R6
//  335 	 static int Bias,Pwm,Last_bias;
//  336          int Amplitude=900;
        MOV.W   #0x384, R4
//  337 	 Bias=Target-Encoder;                //计算偏差
        MOV.W   R6, R15
        SUB.W   R7, R15
        MOVX.W  R15, &??Bias
//  338 	 Pwm+=Velocity_KP*(Bias-Last_bias)+Velocity_KI*Bias;   //增量式PI控制器
        MOVX.W  &??Pwm, R12
        MOV.W   R12, R13
        RLA.W   R13
        SUBC.W  R13, R13
        XOR.W   #0xffff, R13
          CFI FunCall _Cast32sto32f
        CALLA   #_Cast32sto32f
        MOV.W   R12, R10
        MOV.W   R13, R11
        MOVX.W  &??Bias, R12
        SUBX.W  &??Last_bias, R12
        MOV.W   R12, R13
        RLA.W   R13
        SUBC.W  R13, R13
        XOR.W   #0xffff, R13
          CFI FunCall _Cast32sto32f
        CALLA   #_Cast32sto32f
        MOVX.W  &Velocity_KP, R14
        MOVX.W  &Velocity_KP + 2, R15
          CFI FunCall _Mul32f
        CALLA   #_Mul32f
        MOV.W   R12, R8
        MOV.W   R13, R9
        MOVX.W  &??Bias, R12
        MOV.W   R12, R13
        RLA.W   R13
        SUBC.W  R13, R13
        XOR.W   #0xffff, R13
          CFI FunCall _Cast32sto32f
        CALLA   #_Cast32sto32f
        MOVX.W  &Velocity_KI, R14
        MOVX.W  &Velocity_KI + 2, R15
          CFI FunCall _Mul32f
        CALLA   #_Mul32f
        MOV.W   R8, R14
        MOV.W   R9, R15
          CFI FunCall _Add32f
        CALLA   #_Add32f
        MOV.W   R10, R14
        MOV.W   R11, R15
          CFI FunCall _Add32f
        CALLA   #_Add32f
          CFI FunCall _Cast32fto32s
        CALLA   #_Cast32fto32s
        MOVX.W  R12, &??Pwm
//  339 	 Last_bias=Bias;	                   //保存上一次偏差 
        MOVX.W  &??Bias, &??Last_bias
//  340          if(Pwm>Amplitude) Pwm=Amplitude;
        CMPX.W  &??Pwm, R4
        JGE     ??Incremental_PI_A_0
        MOVX.W  R4, &??Pwm
//  341          if(Pwm<0)Pwm=(-1)*Pwm;
??Incremental_PI_A_0:
        CMPX.W  #0x0, &??Pwm
        JGE     ??Incremental_PI_A_1
        PUSH.W  SR
          CFI CFA SP+38
        DINT
        NOP
        MOV.W   #0xffff, &__iar_HWMUL          // MPY
        MOVX.W  &??Pwm, &__iar_HWMUL + 8       // OP2
        MOVX.W  &__iar_HWMUL + 10, &??Pwm      // RESLO
        NOP
        POP.W   SR
          CFI CFA SP+36
        NOP
//  342 	 return Pwm;                         //增量输出
??Incremental_PI_A_1:
        MOVX.W  &??Pwm, R12
        POPM.A  #0x8, R11
          CFI R10H SameValue
          CFI R11H SameValue
          CFI R4H SameValue
          CFI R5H SameValue
          CFI R6H SameValue
          CFI R7H SameValue
          CFI R8H SameValue
          CFI R9H SameValue
          CFI R10L SameValue
          CFI R11L SameValue
          CFI R4L SameValue
          CFI R5L SameValue
          CFI R6L SameValue
          CFI R7L SameValue
          CFI R8L SameValue
          CFI R9L SameValue
          CFI CFA SP+4
        RETA
//  343 }
          CFI EndBlock cfiBlock10

        RSEG DATA20_Z:DATA:SORT:NOROOT(1)
        REQUIRE ?cstart_init_zero20
??Bias:
        DS8 2

