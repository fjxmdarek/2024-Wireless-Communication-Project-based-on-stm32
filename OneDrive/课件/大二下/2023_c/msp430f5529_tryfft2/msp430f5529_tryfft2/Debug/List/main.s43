        MOVX.W  &speed_L, &Encoder_Left
//  380    	vounetr_chack();
          CFI FunCall vounetr_chack
        CALLA   #vounetr_chack
//  381         
//  382 
//  383 	Kinematic_Analysis(Velocity,Angle);  	//小车运动学分析   
        MOVX.W  &Angle, R14
        MOVX.W  &Angle + 2, R15
        MOVX.W  &Velocity, R12
        MOVX.W  &Velocity + 2, R13
          CFI FunCall Kinematic_Analysis
        CALLA   #Kinematic_Analysis
//  384     if(mode==1)
        CMPX.B  #0x1, &mode
        JNE     ??TIMER_TA0_A0_IRQ_Handler_0
//  385     {
//  386 	Motor_A=Incremental_PI_A(Encoder_right,Target_A);                   //===速度闭环控制计算电机A最终PWM
        MOVX.W  &Target_A, R13
        MOVX.W  &Encoder_right, R12
          CFI FunCall Incremental_PI_A
        CALLA   #Incremental_PI_A
        MOVX.W  R12, &Motor_A
//  387 	Motor_B=Incremental_PI_B(speed_L,Target_B);                  //===速度闭环控制计算电机B最终PWM 
        MOVX.W  &Target_B, R13
