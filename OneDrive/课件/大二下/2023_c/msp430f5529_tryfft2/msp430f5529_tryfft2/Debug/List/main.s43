        RSEG `CODE`:CODE:REORDER:NOROOT(1)
//  230 void motor_angle_init()
motor_angle_init:
          CFI Block cfiBlock3 Using cfiCommon1
          CFI Function motor_angle_init
//  231 {
//  232   GPIO_Init(P1,5,GPI);//定义编码器io用于判断方向
        MOV.W   #0x1, R14
        MOV.W   #0x20, R13
        MOV.B   #0x0, R12
          CFI FunCall GPIO_MultiBits_Init
        CALLA   #GPIO_MultiBits_Init
//  233   GPIO_Init(P1,4,GPI);
        MOV.W   #0x1, R14
        MOV.W   #0x10, R13
        MOV.B   #0x0, R12
          CFI FunCall GPIO_MultiBits_Init
        CALLA   #GPIO_MultiBits_Init
//  234   GPIO_Init(P1,3,GPO);//定义编码器io用于判断方向
        MOV.W   #0x2, R14
        MOV.W   #0x8, R13
        MOV.B   #0x0, R12
          CFI FunCall GPIO_MultiBits_Init
        CALLA   #GPIO_MultiBits_Init
//  235   GPIO_Init(P1,2,GPO);
        MOV.W   #0x2, R14
        MOV.W   #0x4, R13
        MOV.B   #0x0, R12
          CFI FunCall GPIO_MultiBits_Init
        CALLA   #GPIO_MultiBits_Init
//  236   GPIO_Init(P1,3,PULL_DOWN);//定义编码器io用于判断方向
        MOV.W   #0x10, R14
        MOV.W   #0x8, R13
        MOV.B   #0x0, R12
          CFI FunCall GPIO_MultiBits_Init
        CALLA   #GPIO_MultiBits_Init
//  237   GPIO_Init(P1,2,PULL_DOWN);
        MOV.W   #0x10, R14
        MOV.W   #0x4, R13
        MOV.B   #0x0, R12
          CFI FunCall GPIO_MultiBits_Init
        CALLA   #GPIO_MultiBits_Init
//  238   GPIO_WriteBit(P1,2,0);
        MOV.B   #0x0, R14
        MOV.B   #0x2, R13
        MOV.B   #0x0, R12
          CFI FunCall GPIO_WriteBit
        CALLA   #GPIO_WriteBit
//  239   GPIO_WriteBit(P1,3,0);
        MOV.B   #0x0, R14
        MOV.B   #0x3, R13
        MOV.B   #0x0, R12
          CFI TailCall GPIO_WriteBit
        BRA     #GPIO_WriteBit
//  240 }
          CFI EndBlock cfiBlock3

        RSEG `CODE`:CODE:REORDER:NOROOT(1)
//  241 void key_init()
key_init:
          CFI Block cfiBlock4 Using cfiCommon1
