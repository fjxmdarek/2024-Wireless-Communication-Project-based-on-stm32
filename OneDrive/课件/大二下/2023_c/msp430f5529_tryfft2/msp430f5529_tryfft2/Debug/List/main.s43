//  356 void vounetr_chack()
vounetr_chack:
          CFI Block cfiBlock12 Using cfiCommon1
          CFI Function vounetr_chack
//  357 {
        PUSHM.A #0x2, R11
          CFI R10L Frame(CFA, -12)
          CFI R10H Frame(CFA, -10)
          CFI R11L Frame(CFA, -8)
          CFI R11H Frame(CFA, -6)
          CFI CFA SP+12
//  358   static int motu1=0;
//  359   static int motu2=0;
//  360   motu1=speed_R/5+motu1*4/5;
        MOVX.W  &speed_R, R12
        MOVX.W  &speed_R + 2, R13
        MOV.W   #0x5, R14
        MOV.W   #0x0, R15
          CFI FunCall ?DivMod32s
        CALLA   #?DivMod32s
        MOV.W   R12, R11
        MOVX.W  &??motu1, R12
        RLAM.W  #0x2, R12
        MOV.W   #0x5, R14
          CFI FunCall ?DivMod16s
        CALLA   #?DivMod16s
        ADD.W   R12, R11
        MOVX.W  R11, &??motu1
//  361   motu2=speed_L/5+motu2*4/5;
        MOVX.W  &speed_L, R12
        MOVX.W  &speed_L + 2, R13
        MOV.W   #0x5, R14
        MOV.W   #0x0, R15
          CFI FunCall ?DivMod32s
        CALLA   #?DivMod32s
        MOV.W   R12, R11
        MOVX.W  &??motu2, R12
        RLAM.W  #0x2, R12
        MOV.W   #0x5, R14
          CFI FunCall ?DivMod16s
        CALLA   #?DivMod16s
        ADD.W   R12, R11
        MOVX.W  R11, &??motu2
//  362   if(((speed_R-motu1)>100)||((motu1-speed_R)>100))
        MOVX.W  &speed_R, R10
        MOVX.W  &speed_R + 2, R11
        MOVX.W  &??motu1, R14
        MOV.W   R14, R15
        RLA.W   R15
        SUBC.W  R15, R15
        XOR.W   #0xffff, R15
        SUB.W   R14, R10
        SUBC.W  R15, R11
        CMP.W   #0x0, R11
        JL      ??vounetr_chack_2
        JNE     ??vounetr_chack_0
        CMP.W   #0x65, R10
        JC      ??vounetr_chack_0
??vounetr_chack_2:
        MOVX.W  &??motu1, R14
        MOV.W   R14, R15
        RLA.W   R15
        SUBC.W  R15, R15
        XOR.W   #0xffff, R15
        SUBX.W  &speed_R, R14
        SUBCX.W &speed_R + 2, R15
        CMP.W   #0x0, R15
        JL      ??vounetr_chack_3
        JNE     ??vounetr_chack_0
        CMP.W   #0x65, R14
        JNC     ??vounetr_chack_3
//  363   {
//  364   speed_R=motu1;
??vounetr_chack_0:
        MOVX.W  &??motu1, R14
        MOV.W   R14, R15
        RLA.W   R15
        SUBC.W  R15, R15
        XOR.W   #0xffff, R15
        MOVX.W  R14, &speed_R
        MOVX.W  R15, &speed_R + 2
//  365   }
//  366   if(((speed_L-motu2)>100)||((motu2-speed_L)>100))
??vounetr_chack_3:
        MOVX.W  &speed_L, R10
        MOVX.W  &speed_L + 2, R11
        MOVX.W  &??motu2, R14
        MOV.W   R14, R15
        RLA.W   R15
        SUBC.W  R15, R15
        XOR.W   #0xffff, R15
        SUB.W   R14, R10
        SUBC.W  R15, R11
        CMP.W   #0x0, R11
        JL      ??vounetr_chack_4
        JNE     ??vounetr_chack_1
        CMP.W   #0x65, R10
        JC      ??vounetr_chack_1
??vounetr_chack_4:
        MOVX.W  &??motu2, R14
        MOV.W   R14, R15
        RLA.W   R15
        SUBC.W  R15, R15
        XOR.W   #0xffff, R15
        SUBX.W  &speed_L, R14
        SUBCX.W &speed_L + 2, R15
        CMP.W   #0x0, R15
        JL      ??vounetr_chack_5
        JNE     ??vounetr_chack_1
        CMP.W   #0x65, R14
        JNC     ??vounetr_chack_5
//  367   {
//  368   speed_L=motu2;
??vounetr_chack_1:
        MOVX.W  &??motu2, R14
        MOV.W   R14, R15
        RLA.W   R15
        SUBC.W  R15, R15
        XOR.W   #0xffff, R15
        MOVX.W  R14, &speed_L
        MOVX.W  R15, &speed_L + 2
//  369   }
//  370   speed_R=speed_R/2+motu1/2;
??vounetr_chack_5:
        MOVX.W  &speed_R, R12
        MOVX.W  &speed_R + 2, R13
        MOV.W   #0x2, R14
        MOV.W   #0x0, R15
          CFI FunCall ?DivMod32s
        CALLA   #?DivMod32s
        MOV.W   R12, R10
        MOV.W   R13, R11
        MOVX.W  &??motu1, R12
        MOV.W   #0x2, R14
          CFI FunCall ?DivMod16s
        CALLA   #?DivMod16s
        MOV.W   R12, R13
        RLA.W   R13
        SUBC.W  R13, R13
        XOR.W   #0xffff, R13
        ADD.W   R12, R10
        ADDC.W  R13, R11
        MOVX.W  R10, &speed_R
        MOVX.W  R11, &speed_R + 2
//  371   speed_L=speed_L/2+motu2/2;
        MOVX.W  &speed_L, R12
        MOVX.W  &speed_L + 2, R13
        MOV.W   #0x2, R14
        MOV.W   #0x0, R15
          CFI FunCall ?DivMod32s
        CALLA   #?DivMod32s
        MOV.W   R12, R10
        MOV.W   R13, R11
        MOVX.W  &??motu2, R12
        MOV.W   #0x2, R14
          CFI FunCall ?DivMod16s
        CALLA   #?DivMod16s
        MOV.W   R12, R13
        RLA.W   R13
        SUBC.W  R13, R13
        XOR.W   #0xffff, R13
        ADD.W   R12, R10
        ADDC.W  R13, R11
        MOVX.W  R10, &speed_L
        MOVX.W  R11, &speed_L + 2
//  372 }
        POPM.A  #0x2, R11
          CFI R10H SameValue
          CFI R11H SameValue
          CFI R10L SameValue
          CFI R11L SameValue
          CFI CFA SP+4
        RETA
          CFI EndBlock cfiBlock12

