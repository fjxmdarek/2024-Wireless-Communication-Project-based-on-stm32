          CFI FunCall Read_Encoder
        CALLA   #Read_Encoder
//  378 	Encoder_right=speed_R;                                       //===读取编码器的值							 //为了保证M法测速的时间基准，首先读取编码器数据
        MOVX.W  &speed_R, &Encoder_right
